<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <I18NRoot Condition="'$(I18NRoot)' == ''">..\..</I18NRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="NoResource\**\*.cs" />
    <ProjectReference Include="$(I18NRoot)\WB.I18N.Avalonia\WB.I18N.Avalonia.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <EmbeddedResource Update="Messages.resx" LogicalName="Benchmark.Messages.resources" />
    <EmbeddedResource Update="Messages.fr.resx" LogicalName="Benchmark.Messages.fr.resources" />
  </ItemGroup>
</Project>
