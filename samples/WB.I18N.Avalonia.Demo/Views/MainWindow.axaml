<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:WB.I18N.Avalonia;assembly=WB.I18N.Avalonia"
        xmlns:localization="clr-namespace:WB.I18N.Avalonia.Demo.Localization"
        xmlns:viewModels="clr-namespace:WB.I18N.Avalonia.Demo.ViewModels"
        x:Class="WB.I18N.Avalonia.Demo.Views.MainWindow"
        x:DataType="viewModels:DemoViewModel"
        Title="WB.I18N.Avalonia 本地化示例"
        Width="900"
        Height="760"
        MinWidth="680"
        MinHeight="560">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="14">
            <TextBlock Text="WB.I18N.Avalonia 功能示例" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="切换语言后观察资源查找、格式化和回退结果。" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="中文" Click="OnChineseClick" />
                <Button Content="English" Click="OnEnglishClick" />
                <Button Content="Français" Click="OnFrenchClick" />
                <Button Content="Français (Canada)" Click="OnCanadianFrenchClick" />
                <TextBlock Text="当前语言：" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="{Binding CurrentLanguage}" VerticalAlignment="Center" />
            </StackPanel>

            <Separator />
            <TextBlock Text="AXAML：固定键与备用文案" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{I18N Key={x:Static localization:I18NKeys.Title}}" />
            <TextBlock Text="{i18n:I18N Key={x:Static localization:I18NKeys.ProductTeach}}" />
            <TextBlock Text="{I18N Key=MissingFixed, Fallback='固定备用文案'}" />

            <Separator />
            <TextBlock Text="AXAML：动态键与动态备用文案" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{I18N Key={Binding StatusKey}}" />
            <TextBlock Text="{I18N Key={Binding MissingKey}, Fallback={Binding MissingFallback}}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="切换资源键" Click="OnStatusClick" />
                <Button Content="切换备用文案" Click="OnFallbackClick" />
            </StackPanel>

            <Separator />
            <TextBlock Text="AXAML：绑定格式化参数" FontSize="18" FontWeight="SemiBold" />
            <TextBlock>
                <TextBlock.Text>
                    <I18N Key="{x:Static localization:I18NKeys.TaskProgress}">
                        <Binding Path="TaskName" />
                        <Binding Path="ItemCount" />
                    </I18N>
                </TextBlock.Text>
            </TextBlock>
            <Button Content="修改格式化参数" Click="OnTaskClick" HorizontalAlignment="Left" />

            <Separator />
            <TextBlock Text="fr-CA 回退：地区译文 / 父级语言 / 默认资源" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{I18N Key={x:Static localization:I18NKeys.RegionalGreeting}}" />
            <TextBlock Text="{I18N Key={x:Static localization:I18NKeys.ParentOnly}}" />
            <TextBlock Text="{I18N Key={x:Static localization:I18NKeys.NeutralOnly}}" />

            <Separator />
            <TextBlock Text="C#：生成的资源键、格式化与语言切换" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="I18N.GetString(I18NKeys.ProductTeach)" />
            <TextBlock Text="{Binding CodeLookup}" />
            <TextBlock Text="{Binding CodeFallback}" />
            <TextBlock Text="{Binding CodeFormat}" />
        </StackPanel>
    </ScrollViewer>
</Window>
