<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <I18NProjectRoot Condition="'$(I18NProjectRoot)' == ''">..\..</I18NProjectRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <ProjectReference Include="$(I18NProjectRoot)\WB.I18N.Avalonia\WB.I18N.Avalonia.csproj" />
    <ProjectReference Include="$(I18NProjectRoot)\WB.I18N.Generator\WB.I18N.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="$(I18NProjectRoot)\WB.I18N.Avalonia\buildTransitive\WB.I18N.Avalonia.targets" />
</Project>
